{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main", "tab-*"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "store:default",
    "opener:default",
    "notification:default",
    "allow-open-external-url",
    "allow-quit-app",
    "allow-get-memory-trim-settings",
    "allow-set-memory-trim-settings",
    "allow-check-for-update",
    "allow-install-update",
    "allow-show-message-notification",
    "allow-list-tabs",
    "allow-create-tab",
    "allow-switch-tab",
    "allow-close-tab"
  ]
}
